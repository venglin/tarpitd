diff --git a/mail/tarpitd/files/tarpitd.in b/mail/tarpitd/files/tarpitd.in
new file mode 100644
index 0000000000..1a5d028cd5
--- /dev/null
+++ b/mail/tarpitd/files/tarpitd.in
@@ -0,0 +1,59 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-2-Clause
+# Copyright (c) 2026 Przemyslaw Frasunek <przemyslaw@frasunek.com>
+#
+# PROVIDE: tarpitd
+# REQUIRE: LOGIN FILESYSTEMS
+# KEYWORD: shutdown
+#
+# Add the following lines to /etc/rc.conf to enable tarpitd:
+#
+# tarpitd_enable="YES"
+# tarpitd_listen="127.0.0.1:8025"
+# tarpitd_maxconn="8192"
+# tarpitd_runas="nobody"
+# tarpitd_flags=""
+#
+# Note: the user to drop to is tarpitd_runas, not tarpitd_user.  rc.subr
+# treats ${name}_user as "start the whole thing under su", which would leave
+# tarpitd unable to write its pidfile or bind a privileged port, and unable
+# to drop privileges itself.
+#
+
+. /etc/rc.subr
+
+name="tarpitd"
+rcvar="tarpitd_enable"
+
+load_rc_config $name
+
+: ${tarpitd_enable:="NO"}
+: ${tarpitd_flags:=""}
+: ${tarpitd_runas:="nobody"}
+: ${tarpitd_listen:="127.0.0.1:8025"}
+: ${tarpitd_maxconn:="4096"}
+: ${tarpitd_pidfile:="/var/run/tarpitd.pid"}
+
+pidfile="${tarpitd_pidfile}"
+command="%%PREFIX%%/sbin/tarpitd"
+command_args="-P ${pidfile} -u ${tarpitd_runas} -l ${tarpitd_listen} -c ${tarpitd_maxconn}"
+
+start_precmd="tarpitd_precmd"
+
+tarpitd_precmd()
+{
+	#
+	# One descriptor per tarpitted connection, so the process limit has
+	# to be at least as large as tarpitd_maxconn.  The daemon raises its
+	# own soft limit, but it cannot exceed the hard limit set here.
+	#
+	local want
+	want=$((tarpitd_maxconn + 128))
+	if [ "$(ulimit -Hn)" -lt "${want}" ]; then
+		ulimit -Hn "${want}" 2>/dev/null || \
+		    warn "cannot raise the descriptor limit to ${want}"
+	fi
+	ulimit -Sn "${want}" 2>/dev/null
+}
+
+run_rc_command "$1"
diff --git a/mail/tarpitd/pkg-descr b/mail/tarpitd/pkg-descr
new file mode 100644
index 0000000000..d0875c0cd4
--- /dev/null
+++ b/mail/tarpitd/pkg-descr
@@ -0,0 +1,22 @@
+tarpitd answers SMTP connections and holds them open for as long as the peer
+can be persuaded to wait.  It is meant to sit behind a packet filter rule that
+redirects known spam sources to it, in the manner of spamd(8) on OpenBSD, and
+it never accepts or delivers anything.
+
+Every reply is a syntactically valid SMTP response, so the sender has no reason
+to give up, but it is written out one byte at a time and commands are read back
+at the same rate.  Every terminal answer is a temporary failure, so the message
+stays in the sender's queue and it comes back later to be tarpitted again.  The
+intent is to occupy a slot in the sending botnet's delivery queue for hours
+rather than to reject mail quickly.
+
+Among its tactics are a delayed and optionally endless multiline greeting,
+detection of clients that transmit before the greeting has finished, padding of
+the EHLO response, a STARTTLS handshake that never completes, an AUTH honeypot
+that decodes and logs the credentials bots offer, and clamped socket buffers so
+the peer's window stays tiny.
+
+tarpitd carries no blocklist and applies no heuristics of its own.  The
+addresses come from an external source, such as fail2ban or blacklistd(8), and
+the only thing that decides whose traffic arrives here is the firewall rule
+that redirects it.
